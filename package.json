{
  "name": "edgetx-radio-manager",
  "productName": "EdgeTX Radio Manager",
  "private": true,
  "version": "0.4.2",
  "description": "Backup, package download and SD card update for EdgeTX radios",
  "author": "Mariator-pro",
  "license": "MIT",
  "type": "module",
  "main": "dist/desktop/main.cjs",
  "bin": {
    "radio-manager": "src/cli/main.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:desktop && node scripts/licenses.ts",
    "build:desktop": "esbuild src/desktop/main.ts --bundle --platform=node --format=cjs --target=node22 --external:electron --outfile=dist/desktop/main.cjs --metafile=dist/desktop-meta.json",
    "start": "node src/cli/main.ts ui",
    "desktop": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "cli": "node src/cli/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.ui.json",
    "lint": "oxlint"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.10.0",
    "electron-builder": "26.17.0",
    "electron-updater": "6.8.10",
    "esbuild": "0.28.2",
    "oxlint": "^1.89.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "io.github.mariator-pro.edgetx-radio-manager",
    "files": [
      "dist/ui/**",
      "dist/desktop/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/THIRD_PARTY_LICENSES.txt",
        "to": "THIRD_PARTY_LICENSES.txt"
      }
    ],
    "directories": {
      "output": "release"
    },
    "afterPack": "scripts/after-pack.ts",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "category": "public.app-category.utilities",
      "artifactName": "edgetx-radio-manager-macos-${arch}-v${version}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "edgetx-radio-manager-win64-portable-v${version}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "artifactName": "edgetx-radio-manager-linux-v${version}.${ext}"
    },
    "nsis": {
      "artifactName": "edgetx-radio-manager-win64-v${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "Mariator-pro",
      "repo": "edgetx-radio-manager"
    }
  }
}
